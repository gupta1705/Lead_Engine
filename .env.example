# ============================================================================
#  ⚠  THIS FILE IS COMMITTED TO GIT. NEVER PUT A REAL VALUE IN IT.
#
#  Every line below must stay EMPTY after the `=`. This file exists to record
#  WHICH secrets the system needs, not what they are.
#
#  Real values go in `.env` (same directory, gitignored, never committed):
#      cp .env.example .env      then fill in `.env`
#
#  Why the split matters: this repo has a GitHub remote. A value committed
#  here is pushed to GitHub and stays in git history permanently — removing
#  the file in a later commit does NOT remove it from history. Recovery means
#  rewriting history AND rotating every key that was ever in it.
# ============================================================================
#
# TVF Universal Lead Engine — credential inventory (P0)
#
# This is the reference list, not the runtime store. The real values are
# pasted into n8n's own encrypted credential store when each rung needs them.
# Keeping a filled-in `.env` on the n8n host means you never hunt for a key
# twice; nothing in this repo reads it automatically.
#
# The "needed at" markers are the point of P0: acquire ALL of these in one
# sitting so no later rung ever stalls on a signup.

# --- Supabase ------------------------------------------------------- live
# Project URL + service-role key. The service-role key bypasses RLS entirely:
# server-side only, never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon (publishable) key — browser-side only, used by the web app.  needed: P18
SUPABASE_ANON_KEY=

# Postgres connection string — this is what `tools/run_sql.py` uses to run SQL
# directly, instead of files being pasted into the Supabase editor by hand.
#
# WHERE TO GET IT:
#   Supabase → Project Settings → Database → Connection string
#   → the **Session pooler** tab (port 5432), NOT "Direct connection"
#     (direct is IPv6-only and usually fails from a home network)
#   → copy the URI, replace [YOUR-PASSWORD] with your database password
#     (the one saved at project creation — NOT the service-role key above)
#
# If the password contains @ : / # or ?, percent-encode it in the URI
# (@ → %40, # → %23, / → %2F, : → %3A, ? → %3F) or the URI will not parse.
#
# This grants full read/write/DDL on the database. run_sql.py never prints it,
# never puts it on a command line, and redacts it from error messages — but it
# is the most powerful secret in this file. It belongs here and nowhere else.
SUPABASE_DB_URL=

# --- Google Cloud: one project, both APIs --------------------------- P0 (a)
# YouTube Data API v3 key. 10k units/day. Restrict to the YouTube Data API.
YOUTUBE_API_KEY=
#                                                                 needed: P4

# Gmail OAuth client (same GCP project, created now so P21 does not stall).
# n8n's Gmail node needs a "Web application" client whose authorised redirect
# URI is exactly:  http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#                                                            needed: P21, P22
# The TVF Gmail address that outreach is sent from and replies land in.
GMAIL_SENDER_ADDRESS=
#                                                                 needed: P21
# Cloud hosts with no disk (Render, Hugging Face Spaces): after running
# `python tools/outreach.py auth` on a laptop, paste the whole contents of
# .gmail_token.json here as ONE line. Laptops leave this blank; the file wins.
GMAIL_TOKEN_JSON=

# --- Segment 3: LCX clipping sends from its own mailbox ------------------
# The segment config names the variable (outreach.sender.email_env). Run
# `SEGMENT_SLUG=lcx-clipping python tools/outreach.py auth` once to create
# .gmail_token.lcx-clipping.json; on a diskless host paste its contents below.
GMAIL_SENDER_ADDRESS_LCX_CLIPPING=
# LCX clipping sends from up to three mailboxes (config outreach.mailboxes).
# Each one: its address here, then `SEGMENT_SLUG=lcx-clipping python
# tools/outreach.py auth --mailbox main|second|third` once on the laptop.
# A mailbox left blank simply takes no part. Diskless hosts only: the token
# file's contents go in the matching GMAIL_TOKEN_JSON_LCX_CLIPPING_<KEY>.
GMAIL_SENDER_ADDRESS_LCX_2=
GMAIL_SENDER_ADDRESS_LCX_3=
GMAIL_TOKEN_JSON_LCX_CLIPPING_MAIN=
GMAIL_TOKEN_JSON_LCX_CLIPPING_SECOND=
GMAIL_TOKEN_JSON_LCX_CLIPPING_THIRD=

# --- Multi-segment portal ------------------------------------------------
# SEGMENT_SLUG is the default segment; the Projects menu switches per browser.
# SEGMENTS_ALLOWED (comma list) pins a deployment to a subset -- that is how a
# portal for one segment is made (deploy/render.lcx-clipping.yaml sets it).
# SCHEDULER_SEGMENTS narrows which segments the in-app scheduler runs.
SEGMENTS_ALLOWED=
SCHEDULER_SEGMENTS=

# --- Apollo ---------------------------------------------------------- P0 (b)
# The Universal project's search page (tools/apollo.py). In Apollo: Settings ->
# Integrations -> API Keys -> Create new key, and tick these five endpoints (or
# turn on "Set as master key"):
#   mixed_people/api_search        people search           0 credits
#   mixed_companies/search         company search          1 credit a page
#   people/bulk_match              reveal and save people  1 credit a person found
#   usage_stats/credit_usage_stats credits left            0 credits
#   users/api_profile              connection check        0 credits
# Put the same value in Render's Environment tab for the live site. Never paste
# it into a chat or an email. Check it with: python tools/apollo.py --check
APOLLO_API_KEY=
#                                                     needed: the Universal page

# --- Groq: the opening line of a draft ---------------------------------------
# Optional. With it, a segment whose config has outreach.generated_hook on lets
# a model write the first sentence of each draft from that lead's own facts
# (public counts only -- never an address, a contact name, page text, a URL,
# the channel's country or an episode title). Free Developer plan; the daily send cap runs out long
# before the quota does. Groq's default is no retention and its services
# agreement says inputs are not used for training, which is why this is not
# Gemini's free tier -- Google's terms say that one IS training data.
#
# WITHOUT IT nothing changes: every draft uses the hook the engine assembles
# itself. Get one at console.groq.com -> API Keys.
GROQ_API_KEY=
#                                                                 needed: never
#                                            (drafting works fully without it)

# --- Anthropic -------------------------------------------------------- P0 (c)
# Reply classifier only. Pennies of spend. Model: claude-haiku-4-5-20251001.
ANTHROPIC_API_KEY=
#                                                                needed: P22
SESSION_SECRET=
SCHEDULER_ENABLED=
ALERT_WEBHOOK_URL=
DOMAIN=
